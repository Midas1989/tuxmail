{
  "name": "tuxmail-mobile",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "TuxMail Android app (Capacitor thin client for any TuxMail server, KONZEPT 15.9 stage A)",
  "scripts": {
    "build:web": "npm --prefix ../frontend run build",
    "sync": "cap sync android",
