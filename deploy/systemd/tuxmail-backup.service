# Beispiel (aus der Ansible-Rolle tuxmail erzeugt) – Pfade ggf. anpassen.
[Unit]
Description=TuxMail data backup
Documentation=https://github.com/Midas1989/Mailclient/tree/main/deploy
After=tuxmail.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tuxmail-backup --stop scheduled 14
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
ReadWritePaths=/var/backups/tuxmail
