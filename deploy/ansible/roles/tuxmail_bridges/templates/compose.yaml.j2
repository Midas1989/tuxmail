# {{ ansible_managed }}
# Bridge-Modus im CONTAINER-Modus (tuxmail_bridges_runtime=container) – Ausnahme vom
# Standard ohne Container. Alle Ports sind nur auf 127.0.0.1 veröffentlicht.
# Projektname wird per "-p {{ tuxmail_bridges_project }}" gesetzt.
# PDF/Gotenberg: Rolle tuxmail_pdf (tuxmail_pdf_renderer=gotenberg_container).
{% set vol = tuxmail_bridges_volume_opts %}
services:
{% if tuxmail_matrix_server == 'synapse' %}
  homeserver:
    image: {{ tuxmail_bridges_synapse_image }}
    container_name: {{ tuxmail_bridges_project }}-homeserver
    restart: always
    environment:
      SYNAPSE_CONFIG_PATH: /data/homeserver.yaml
    volumes:
      - {{ tuxmail_bridges_dir }}/synapse:/data{{ vol }}
    ports:
      - "127.0.0.1:{{ tuxmail_matrix_port }}:8008"
{% else %}
  homeserver:
    image: {{ tuxmail_bridges_continuwuity_image }}
    container_name: {{ tuxmail_bridges_project }}-homeserver
    restart: always
    environment:
      CONTINUWUITY_SERVER_NAME: {{ tuxmail_matrix_server_name | to_json }}
      CONTINUWUITY_DATABASE_PATH: /var/lib/continuwuity
      CONTINUWUITY_ADDRESS: "0.0.0.0"
      CONTINUWUITY_PORT: "8008"
      CONTINUWUITY_ALLOW_REGISTRATION: "false"
      CONTINUWUITY_ALLOW_FEDERATION: {{ (tuxmail_matrix_federation | bool | string | lower) | to_json }}
    volumes:
      - {{ tuxmail_bridges_dir }}/continuwuity:/var/lib/continuwuity{{ vol }}
    ports:
      - "127.0.0.1:{{ tuxmail_matrix_port }}:8008"
{% endif %}
{% for bridge in tuxmail_bridges_mautrix %}

  mautrix-{{ bridge.name }}:
    image: {{ bridge.image }}
    container_name: {{ tuxmail_bridges_project }}-mautrix-{{ bridge.name }}
    restart: always
    depends_on:
      - homeserver
    volumes:
      - {{ tuxmail_bridges_dir }}/{{ bridge.name }}:/data{{ vol }}
{% endfor %}
