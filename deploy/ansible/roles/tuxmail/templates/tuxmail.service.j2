# {{ ansible_managed }}
[Unit]
Description=TuxMail server (web mode)
Documentation=https://github.com/Midas1989/Mailclient/tree/main/deploy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ tuxmail_user }}
Group={{ tuxmail_group }}
WorkingDirectory={{ tuxmail_data_dir }}
Environment=HOME={{ tuxmail_data_dir }}
{% for key, value in tuxmail_service_environment.items() %}
Environment={{ (key ~ '=' ~ value) | to_json }}
{% endfor %}
# Optionale Einstellungen der PDF-Erzeugung (TUXMAIL_CHROMIUM_PATH bzw.
# TUXMAIL_GOTENBERG_URL), verwaltet von der Rolle tuxmail_pdf. "-" = darf fehlen.
EnvironmentFile=-{{ tuxmail_pdf_env_file }}
ExecStartPre={{ tuxmail_binary }} check-config --config {{ tuxmail_config_file }}
{% if tuxmail_listen_is_socket | bool %}
# Unix-Socket: /run/{{ tuxmail_socket_path | dirname | basename }} gehört der Socket-Gruppe (setgid),
# damit nginx (Mitglied von {{ tuxmail_socket_group }}) verbinden darf.
RuntimeDirectory={{ tuxmail_socket_path | dirname | basename }}
RuntimeDirectoryMode=0750
ExecStartPre=+/usr/bin/chgrp {{ tuxmail_socket_group }} {{ tuxmail_socket_path | dirname }}
ExecStartPre=+/usr/bin/chmod 2750 {{ tuxmail_socket_path | dirname }}
UMask=0007
{% else %}
UMask=0027
{% endif %}
ExecStart={{ tuxmail_binary }} serve --config {{ tuxmail_config_file }}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE={{ tuxmail_limit_nofile | int }}

# --- Härtung ---------------------------------------------------------------
ProtectSystem=strict
ReadWritePaths={{ tuxmail_data_dir }} {{ tuxmail_log_dir }}
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
{% if tuxmail_bind_privileged_port | bool %}
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
{% else %}
CapabilityBoundingSet=
AmbientCapabilities=
{% endif %}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
{% if tuxmail_service_chromium_compat | bool %}
# tuxmail_pdf_renderer=chromium: Chromium (Kindprozess von TuxMail) braucht für
# seine eigene Sandbox Benutzer-/PID-/Netz-Namensräume sowie chroot/capset und
# für die JavaScript-JIT beschreib- und ausführbaren Speicher.
RestrictNamespaces=~cgroup
{% else %}
RestrictNamespaces=true
{% endif %}
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute={{ 'false' if tuxmail_service_chromium_compat | bool else 'true' }}
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
{% if not (tuxmail_service_chromium_compat | bool) %}
SystemCallFilter=~@privileged
{% endif %}
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
