{
  "name": "tuxmail-frontend",
  "private": true,
  "version": "1.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "TuxMail frontend (Svelte 5) - shared by the Wails desktop shell and the web client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:capacitor": "vite build --mode capacitor",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "audit:mobile": "node scripts/mobile-audit.cjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@lucide/svelte": "1.67.0",
    "qrcode-generator": "2.0.4",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.5",
    "jsdom": "31.0.0",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
