# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Pinned signal-cli and Java runtime downloads for the Signal plugin.
# THE single place for versions, URLs and SHA-256 checksums: read by
#   - internal/messenger/signalcli (embedded; on-demand install in the app),
#   - build/signal-cli.sh (bundling in release packages and the Docker image).
#
# Format: KEY=VALUE lines (POSIX-shell compatible, no quotes, no spaces).
# An empty *_SHA256 means "not pinned yet": bundling (TUXMAIL_SIGNAL_CLI=bundle)
# and the on-demand install refuse to use that download.
#
# Update (needs github.com and api.github.com, e.g. on a CI runner or via
# the manual workflow .github/workflows/signal-cli-pin.yml):
#   build/signal-cli.sh pin [SIGNAL_CLI_VERSION|latest] [TEMURIN_VERSION]
# It downloads every file, compares the SHA-256 with GitHub's asset digest
# (signal-cli) and Adoptium's published .sha256.txt (Temurin) and rewrites
# this file. Review the diff and commit it.
#
# signal-cli must stay recent: the Signal servers reject clients older than
# about three months, so bump it with every TuxMail release.
#
# Platform plan (signalcli.PlanFor):
#   linux/amd64    GraalVM native build (no Java needed)
#   linux/arm64    JVM build + Temurin JRE linux aarch64
#   windows/amd64  JVM build + Temurin JRE windows x64
#   windows/arm64  JVM build + Temurin JRE windows x64 (x64 emulation of
#                  Windows 11 on ARM: libsignal-client ships no Windows ARM64
#                  native library)

SIGNAL_CLI_VERSION=0.13.18
SIGNAL_CLI_JVM_URL=https://github.com/AsamK/signal-cli/releases/download/v0.13.18/signal-cli-0.13.18.tar.gz
SIGNAL_CLI_JVM_SHA256=
SIGNAL_CLI_NATIVE_URL=https://github.com/AsamK/signal-cli/releases/download/v0.13.18/signal-cli-0.13.18-Linux-native.tar.gz
SIGNAL_CLI_NATIVE_SHA256=

TEMURIN_VERSION=21.0.8+9
TEMURIN_LINUX_AARCH64_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.8%2B9/OpenJDK21U-jre_aarch64_linux_hotspot_21.0.8_9.tar.gz
TEMURIN_LINUX_AARCH64_SHA256=
TEMURIN_WINDOWS_X64_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.8%2B9/OpenJDK21U-jre_x64_windows_hotspot_21.0.8_9.zip
TEMURIN_WINDOWS_X64_SHA256=
